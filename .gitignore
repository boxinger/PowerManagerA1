# ============================================
# STM32 CubeMX + Keil MDK-ARM 项目 .gitignore
# ============================================

# ----------------------------------------------------
# 1. 完全忽略的文件夹（所有内容都不需要版本控制）
# ----------------------------------------------------

# Keil/EIDE 编译输出目录 - 所有内容都可以忽略
MDK-ARM/build/
MDK-ARM/Objects/
MDK-ARM/Listings/
MDK-ARM/RTE/

# EIDE 配置目录（个人设置）
MDK-ARM/.eide/
MDK-ARM/.cmsis/
MDK-ARM/.vscode/

# 调试配置目录
MDK-ARM/DebugConfig/

# ----------------------------------------------------
# 2. 需要保留的 Keil 配置文件（明确列出）
# ----------------------------------------------------
# !MDK-ARM/*.uvprojx     # Keil 工程文件 - 必须保留
# !MDK-ARM/*.uvoptx     # Keil 选项文件 - 必须保留

# ----------------------------------------------------
# 3. 需要忽略的特定文件类型（在根目录或其他位置）
# ----------------------------------------------------

# Keil 用户界面设置文件（个人配置）
MDK-ARM/*.uvguix.*

# Keil 调试日志文件
MDK-ARM/JLinkLog.txt
MDK-ARM/JLinkSettings.ini

# 链接器脚本文件（通常是生成的）
*.ld
*.lds
*.scvd

# 编译日志和配置文件
*.log
*.params
*.jlink
*.json
*.db

# ----------------------------------------------------
# 4. CubeMX 相关文件
# ----------------------------------------------------
# 需要保留：
#   *.ioc          - CubeMX 项目配置文件 ✓
#   .mxproject     - CubeMX 项目元数据 ✓
# 需要忽略：
*.mxproject.bak
*.ioc.bak
._*.ioc

# ----------------------------------------------------
# 5. 编译输出文件（通用）
# ----------------------------------------------------
*.axf
*.elf
*.hex
*.bin
*.s19
*.map
*.map.*
*.lst
*.lnp
*.htm
*.sct
*.objlist

# ----------------------------------------------------
# 6. 编译中间文件
# ----------------------------------------------------
*.d
*.o
*.crf
*.dep
*.iex
*.tra
*.cdb

# ----------------------------------------------------
# 7. 编辑器临时文件
# ----------------------------------------------------
*.swp
*~
*.swo
*.bak
*.backup
.DS_Store
Thumbs.db
Desktop.ini

# ----------------------------------------------------
# 8. IDE 配置文件
# ----------------------------------------------------
.vscode/
.idea/
*.iml
*.code-workspace

# ----------------------------------------------------
# 9. 系统临时文件
# ----------------------------------------------------
*.tmp
*.temp
*.pid
*.pid.lock

# ----------------------------------------------------
# 10. 版本控制文件
# ----------------------------------------------------
.git/
.gitattributes
.gitmodules
.svn/

# ----------------------------------------------------
# 11. 需要保留的重要目录和文件（注释说明）
# ----------------------------------------------------
# !Core/                # 用户代码 - 必须保留
# !Drivers/             # HAL 库 - 必须保留
# !User/                # 用户自定义代码 - 必须保留
# !*.ioc                # CubeMX 配置文件 - 必须保留
# !.mxproject           # CubeMX 项目文件 - 必须保留
*.bin
*.map
*.lst

# ----------------------------------------------------
# 5. 调试和测试文件
# ----------------------------------------------------
*.dbg
*.debug
*.pdb
*.test
*.spec

# ----------------------------------------------------
# 6. 版本控制系统文件
# ----------------------------------------------------
# Git 相关
.git/
.gitattributes
.gitmodules

# SVN 相关
.svn/

# ----------------------------------------------------
# 7. IDE 和编辑器文件
# ----------------------------------------------------
# Visual Studio Code
.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains IDEs
.idea/
*.iml
*.iws

# Eclipse
.project
.classpath
.settings/

# ----------------------------------------------------
# 8. 操作系统和编辑器临时文件
# ----------------------------------------------------
# 编辑器备份文件
*.swp
*~
*.swo
*.bak
*.backup

# 系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows 系统文件
Desktop.ini

# ----------------------------------------------------
# 9. 日志和临时文件
# ----------------------------------------------------
*.log
*.tmp
*.temp
*.pid
*.pid.lock

# ----------------------------------------------------
# 10. 文档和配置备份
# ----------------------------------------------------
*.orig
*.rej
*.old

# ----------------------------------------------------
# 11. 包管理器和构建工具
# ----------------------------------------------------
# npm
node_modules/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# ----------------------------------------------------
# 12. 需要保留的重要文件（注释说明）
# ----------------------------------------------------
# !MDK-ARM/*.uvprojx     # Keil 工程文件 - 必须保留
# !MDK-ARM/*.uvoptx     # Keil 选项文件 - 必须保留
# !*.ioc                # CubeMX 配置文件 - 必须保留
# !.mxproject           # CubeMX 项目文件 - 必须保留
# !Core/                # 用户代码 - 必须保留
# !Drivers/             # HAL 库 - 必须保留
# !Inc/                 # 头文件 - 必须保留
# !Src/                 # 源文件 - 必须保留
# !User/                # 用户自定义代码 - 必须保留
